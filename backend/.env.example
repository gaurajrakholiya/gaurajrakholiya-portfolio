# Resend API key — https://resend.com/api-keys
# Without this (and the two addresses below) POST /contact returns 503 rather
# than pretending to have sent the message.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=gaurajrakholiya@gmail.com

# Must be an address on a domain verified in Resend. Resend's shared sandbox
# sender (onboarding@resend.dev) works for testing but only delivers to the
# account owner's own address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Comma-separated list of origins allowed to call this API.
# http://localhost:5173 is added automatically when NODE_ENV is not production.
ALLOWED_ORIGIN=https://gaurajrakholiya.vercel.app

# --- Résumé upload (/admin on the site) -------------------------------------

# Vercel Blob store token. Create a Blob store in the Vercel dashboard and this
# is added to the project automatically; pull it locally with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Password for the /admin upload page. Must be at least 16 characters — the
# guard refuses to run with anything shorter, and refuses everything if unset.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Where GET /resume redirects before the first upload. Defaults to
# <first ALLOWED_ORIGIN>/resume.pdf, which is the copy committed in the repo.
FALLBACK_RESUME_URL=

# Local dev port only; Vercel ignores this.
PORT=3001
